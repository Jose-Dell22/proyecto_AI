# Copy to .env for local Docker:  copy .env.example .env

DOCKERHUB_USER=local
IMAGE_TAG=latest

# Web UI → http://localhost:8080
FRONTEND_PORT=8080

# API  → http://localhost:5000/health
BACKEND_PORT=5000

# Leave empty when using root docker-compose (nginx proxies API)
REACT_APP_API_URL=

CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080
